CREATE TABLE celestialObject (
    id              INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    displayName     TEXT    NOT NULL,
    objectId        TEXT    NOT NULL,
    ra              REAL    NOT NULL,
    dec             REAL    NOT NULL,
    type            TEXT    NOT NULL,
    subType         TEXT,
    constellation   TEXT,
    recommended     INTEGER NOT NULL DEFAULT 1,
    magnitude       REAL,
    angularSizeMajor REAL,
    angularSizeMinor REAL,
    userAdded       INTEGER NOT NULL DEFAULT 0,
    variablePeriodDays REAL,
    variableEpochJd REAL,
    variableEpochType TEXT
);

selectAll:
SELECT * FROM celestialObject ORDER BY id;

selectRecommended:
SELECT * FROM celestialObject WHERE recommended = 1 ORDER BY id;

selectByObjectId:
SELECT * FROM celestialObject WHERE objectId = ?;

insert:
INSERT INTO celestialObject (displayName, objectId, ra, dec, type, subType, constellation, recommended, magnitude, angularSizeMajor, angularSizeMinor, variablePeriodDays, variableEpochJd, variableEpochType)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertUserObject:
INSERT INTO celestialObject (displayName, objectId, ra, dec, type, subType, constellation, recommended, magnitude, angularSizeMajor, angularSizeMinor, userAdded, variablePeriodDays, variableEpochJd, variableEpochType)
VALUES (?, ?, ?, ?, ?, ?, ?, 1, ?, ?, ?, 1, ?, ?, ?);

deleteAll:
DELETE FROM celestialObject;

deleteSystemObjects:
DELETE FROM celestialObject WHERE userAdded = 0;

deleteSystemVariableStars:
DELETE FROM celestialObject WHERE userAdded = 0 AND type = 'VARIABLE_STAR';

deleteById:
DELETE FROM celestialObject WHERE id = ?;

updateUserObject:
UPDATE celestialObject
SET displayName = ?, ra = ?, dec = ?, type = ?, magnitude = ?, subType = ?, constellation = ?, variablePeriodDays = ?, variableEpochJd = ?, variableEpochType = ?
WHERE id = ? AND userAdded = 1;
