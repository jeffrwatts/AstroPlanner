CREATE TABLE equipmentConfig (
    id                 INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name               TEXT    NOT NULL,
    focalLength        REAL    NOT NULL,
    aperture           REAL    NOT NULL,
    focalReducerFactor REAL    NOT NULL,
    sensorWidth        REAL    NOT NULL,
    sensorHeight       REAL    NOT NULL
);

selectAll:
SELECT * FROM equipmentConfig ORDER BY id;

insert:
INSERT INTO equipmentConfig (name, focalLength, aperture, focalReducerFactor, sensorWidth, sensorHeight)
VALUES (?, ?, ?, ?, ?, ?);

update:
UPDATE equipmentConfig
SET name=?, focalLength=?, aperture=?, focalReducerFactor=?, sensorWidth=?, sensorHeight=?
WHERE id=?;

deleteById:
DELETE FROM equipmentConfig WHERE id=?;
