CREATE TABLE equipmentConfig (
    id                 INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name               TEXT    NOT NULL,
    otaName            TEXT    NOT NULL DEFAULT '',
    cameraName         TEXT    NOT NULL DEFAULT '',
    focalLength        REAL    NOT NULL,
    aperture           REAL    NOT NULL,
    focalReducerFactor REAL    NOT NULL,
    pixelSize          REAL    NOT NULL,
    resolutionWidth    INTEGER NOT NULL,
    resolutionHeight   INTEGER NOT NULL
);

selectAll:
SELECT * FROM equipmentConfig ORDER BY id;

insert:
INSERT INTO equipmentConfig (name, otaName, cameraName, focalLength, aperture, focalReducerFactor, pixelSize, resolutionWidth, resolutionHeight)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE equipmentConfig
SET name=?, otaName=?, cameraName=?, focalLength=?, aperture=?, focalReducerFactor=?, pixelSize=?, resolutionWidth=?, resolutionHeight=?
WHERE id=?;

deleteById:
DELETE FROM equipmentConfig WHERE id=?;
